# ============================================
# 🔧 GRAVITATIONAL LENSING TOOLKIT
# Environment Configuration Template
# ============================================
# 
# ⚠️  IMPORTANT: 
# 1. Copy this file to .env (without .example)
# 2. Review credentials/secrets before production deployment
# 3. NEVER commit the .env file to git (it's in .gitignore)
#
# 🔴 = REQUIRED - Must be configured
# 🟡 = OPTIONAL - Recommended for full functionality
# 🟢 = OK - Default values work fine
# ============================================

# ============================================
# DATABASE CONFIGURATION
# ============================================
# 🔴 REQUIRED: Configure your PostgreSQL credentials
DATABASE_URL=postgresql://lensing_user:lensing_password_dev_only@localhost:5432/lensing_db
POSTGRES_USER=lensing_user
POSTGRES_PASSWORD=lensing_password_dev_only
POSTGRES_DB=lensing_db

# ============================================
# SECURITY & AUTHENTICATION
# ============================================
# 🔴 REQUIRED: Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=5a7f4ddab3126bd0b3aa8246f0ec949611239fcb4e94ce7d2e5878fb1d76de43
JWT_SECRET=2fbe8e2e1423ebf9861a36c2e4a80a98fdfaf9d27a311bd6a7f3a65a44fe6c2f

# ============================================
# DOCKER & CI/CD
# ============================================
# 🟡 OPTIONAL: For CI/CD pipeline (create account at hub.docker.com)
DOCKER_USERNAME=
DOCKER_PASSWORD=

# ============================================
# AWS CONFIGURATION
# ============================================
# 🟡 OPTIONAL: Only for cloud deployment
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=lensing-data

# ============================================
# NOTIFICATIONS
# ============================================
# 🟡 OPTIONAL: Get from https://api.slack.com/apps
SLACK_WEBHOOK_URL=

# ============================================
# ENVIRONMENT
# ============================================
# 🔴 REQUIRED: Set to 'production' when deploying
ENVIRONMENT=development
DEBUG=True

# See full template for all options
# Run: python scripts/check_config.py to verify setup
